# PRAGYA Atmospheric Intelligence Architecture
# Environment Configuration Template

# -----------------------------------------------------------------------------
# 1. Neon PostgreSQL Database
# -----------------------------------------------------------------------------
# Neon connection string (pooled or direct)
# Format: postgresql://[user]:[password]@[neon-host]/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Server Port (optional, default: 3000 for PRAGYA development)
PORT=3000

# -----------------------------------------------------------------------------
# 2. Authoritative Meteorological Data Sources (Server-Side Only)
# -----------------------------------------------------------------------------
# Note: In accordance with scientific research protocol, if credentials are
# not configured, the application reports 'CREDENTIALS REQUIRED' or 'NOT CONFIGURED'
# and will NEVER fake operational connectivity.

# ISRO Meteorological and Oceanographic Satellite Data Archival Centre (MOSDAC)
# Required for INSAT-3DR / 3DS HDF5 Level-1B & L2 products (TIR, UTH, QPE)
MOSDAC_USERNAME=""
MOSDAC_PASSWORD=""

# India Meteorological Department (IMD)
# Required for IMD AWS REST APIs and National Data Centre archives
IMD_API_KEY=""

# Copernicus Climate Data Store (CDS)
# Required for ERA5 Atmospheric Reanalysis multi-level NetCDF downloads
# Format: UID:API-KEY
CDS_API_KEY=""

# NASA Earthdata Login
# Required for NASA GPM IMERG Early/Late/Final precipitation granules
NASA_EARTHDATA_USERNAME=""
NASA_EARTHDATA_PASSWORD=""
